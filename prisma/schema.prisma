generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Baris URL dihapus di Prisma v7
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  stripeCustomerId String?  @unique
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}